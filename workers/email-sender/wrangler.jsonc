{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gss-playbook-email",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "no-reply@greenwichsportssystems.com"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "RESET_RATE_LIMITER",
      "namespace_id": "2026091401",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
