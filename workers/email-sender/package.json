{
  "name": "@gss/playbook-email-sender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check": "npm run types:check && npm run typecheck && npm test && npm run deploy:dry-run"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.131.1"
  }
}
